<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_ayah"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_kicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:letterSpacing="0.06"
        android:text="@string/widget_ayah_label"
        android:textAllCaps="true"
        android:textColor="#C7D2FE"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_arabic"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/amiri"
        android:gravity="end|center_vertical"
        android:maxLines="6"
        android:text="@string/widget_placeholder"
        android:textAlignment="viewEnd"
        android:textColor="#FFFFFF"
        android:textDirection="rtl"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/widget_english"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="#E0E7FF"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/widget_ref"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#C7D2FE"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
