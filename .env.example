# Quran Foundation API credentials (used by build tools in tools/ only)
# These are NOT needed at runtime -- the app runs fully offline.
# Get credentials from: https://quran.foundation
QF_CLIENT_ID=your_client_id
QF_CLIENT_SECRET=your_client_secret
QF_TOKEN_URL=https://oauth2.quran.foundation/token
QF_CONTENT_BASE=https://api.quran.com/api/v4
