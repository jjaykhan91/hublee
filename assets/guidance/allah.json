      "surahId": 2,
      "ayah": 255,
      "why": "He is the Ever-Living, the Self-Sustaining. Nothing escapes His knowledge."
    },
    {
      "title": "The last verses of Al-Hashr",
      "surahId": 59,
      "ayah": 22,
      "ayahEnd": 24,
      "why": "A cluster of His names: the King, the Holy, the Source of Peace, the Creator."
    },
    {
      "title": "He is near",
      "surahId": 2,
      "ayah": 186,
      "why": "\"I am truly near. I respond to one's prayer when they call upon Me.\""
    },
    {
      "title": "The First and the Last",
      "surahId": 57,
      "ayah": 3,
      "why": "He is the First and the Last, the Most High and Most Near; He has knowledge of all things."
    },
    {
      "title": "Created to worship Him",
      "surahId": 51,
      "ayah": 56,
      "why": "\"I did not create jinn and humans except to worship Me.\""
    },
    {
      "title": "Call on Him by His names",
